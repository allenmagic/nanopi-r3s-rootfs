{
  "log": {
    "level": "error",
    "timestamp": true,
    "output": "/dev/null"
  },

  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "local",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "udp",
        "tag": "yunshu",
        "server": "10.251.1.1",
        "server_port": 53,
        "detour": "yunshu-dns"
      }
    ],
    "rules": [
      {
        "rule_set": ["yunshu-domains"],
        "server": "yunshu"
      }
    ],
    "final": "local",
    "cache_capacity": 8192,
    "strategy": "ipv4_only"
  },

  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "__LAN_IP__",
      "listen_port": 53
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun0",
      "address": ["172.19.0.1/30"],
      "mtu": 1280,
      "auto_route": true,
      "auto_redirect": true,
      "exclude_uid": [0],
      "route_exclude_address": [
        "10.251.1.1/32",
        "__LAN_NET__"
      ],
      "route_exclude_address_set": ["bypass-cidrs"],
      "include_interface": ["__LAN_IFACE__"],
      "exclude_interface": ["tun0"],
      "strict_route": false,
      "stack": "system",
      "endpoint_independent_nat": false,
      "udp_timeout": "5m"
    }
  ],

  "endpoints": [
    {
      "type": "tailscale",
      "tag": "hs-aliyun",
      "system_interface": true,
      "system_interface_name": "ts0",
      "state_directory": "/etc/sing-box/headscale",
      "auth_key": "__ROUTER_HEADSCALE_AUTH_KEY__",
      "control_url": "__ROUTER_HEADSCALE_CTL_URL__",
      "hostname": "__ROUTER_HOSTNAME__",
      "advertise_routes": ["__LAN_NET__"]
    }
  ],

  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "direct",
      "tag": "yunshu-dns",
      "bind_interface": "tun0"
    },
    {
      "type": "bridge",
      "tag": "yunshu-bridge",
      "interface": "tun0",
      "bridge_name": "sbbr",
      "iproute2_table_index": 2200,
      "iproute2_rule_index": 500
    }
  ],

  "route": {
    "rules": [
      {
        "inbound": ["dns-in"],
        "action": "hijack-dns"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "preferred_by": ["yunshu-bridge"],
        "rule_set": ["yunshu-domains"],
        "action": "route",
        "outbound": "yunshu-bridge"
      },
      {
        "preferred_by": ["yunshu-bridge"],
        "ip_cidr": ["198.18.0.0/15"],
        "action": "route",
        "outbound": "yunshu-bridge"
      },
      {
        "process_path": ["/usr/sbin/tailscaled", "/usr/bin/tailscale"],
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "ip_cidr": ["100.64.0.0/10"],
        "action": "route",
        "outbound": "hs-aliyun"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct-out"
      },
      {
        "action": "route",
        "outbound": "direct-out"
      }
    ],
    "rule_set": [
      {
        "tag": "yunshu-domains",
        "type": "local",
        "format": "source",
        "path": "/etc/sing-box/rules/yunshu-domains.json"
      },
      {
        "tag": "bypass-cidrs",
        "type": "local",
        "format": "source",
        "path": "/etc/sing-box/rules/bypass-cidrs.json"
      }
    ],
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "local"
    },
    "final": "direct-out"
  }
}
