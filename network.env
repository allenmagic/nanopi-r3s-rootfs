# ============================
# 路由器网络拓扑配置
# ============================

# ---------- WAN 口 ----------
# 注意：R3S 的内核命名与丝印相反（实测）——
#   丝印 WAN = 内核 eth1（SoC GMAC fe010000.ethernet）
#   丝印 LAN = 内核 eth0（PCIe RTL8168H 0000:01:00.0）
WAN_IFACE=eth1
WAN_MODE=dhcp                      # dhcp | static | pppoe
# static/pppoe 模式才需要以下
# WAN_IP=192.168.1.100
# WAN_GATEWAY=192.168.1.1
# WAN_DNS1=1.1.1.1
# WAN_DNS2=8.8.8.8

# ---------- LAN 口 ----------
LAN_IFACE=eth0
LAN_IP=192.168.8.1
LAN_NETMASK=255.255.255.0
LAN_CIDR=24
LAN_NETWORK=192.168.8.0/24

# ---------- DHCP 服务器 ----------
DHCP_RANGE_START=192.168.8.100
DHCP_RANGE_END=192.168.8.200
DHCP_LEASE_TIME=12h
