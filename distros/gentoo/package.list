# ============================================================
# Gentoo 包列表（通过 ROOT= emerge 安装到目标 rootfs）
#
# 语法：
#   [pm] <package>                —— emerge 安装（ROOT=${ROOTFS} emerge）
#   [dl@<url>] <binary_name>      —— 下载 URL 到 /usr/local/bin/<binary_name>
#   [fw@<url>] <relative_path>    —— 下载固件到 /lib/firmware/<relative_path>
#
# 三段式：base / sing-box / landscape
# ============================================================

# ========== base ==========
[pm] sys-apps/busybox
[pm] sys-apps/baselayout
[pm] app-shells/bash
[pm] net-misc/openssh
[pm] app-misc/ca-certificates
[pm] net-misc/curl
[pm] app-editors/nano
# 时间同步由 busybox ntpd 负责（无需额外包）
[pm] sys-apps/kmod
[pm] sys-apps/iproute2
[pm] sys-apps/util-linux
# 首启扩容：growpart 改分区 + resize2fs 扩 fs
[pm] sys-fs/e2fsprogs
[pm] sys-fs/growpart
[pm] sys-libs/timezone-data
[pm] sys-apps/openrc
# netifrc：/etc/init.d/net.lo 与 net.<iface> 的服务框架
[pm] net-misc/netifrc
[pm] net-misc/rsync
[pm] sys-process/procps
[pm] app-misc/fastfetch
[pm] net-dns/dnsmasq
[pm] net-firewall/nftables
# Gentoo 没有 linux-firmware-rtl_nic 拆分包；只下载 R3S LAN 需要的 rtl8168h-2.fw
[fw@https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git/plain/rtl_nic/rtl8168h-2.fw] rtl_nic/rtl8168h-2.fw
[pm] app-containers/podman
[pm] app-containers/podman-compose
[dl@https://pkgs.tailscale.com/stable/tailscale_latest_arm64.tgz] tailscale
[dl@https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64] cloudflared

# ========== sing-box ==========
[dl@https://github.com/allenmagic/nanopi-r3s-sing-box/releases/download/sing-box-router-v1.14.4/sing-box-router-linux-arm64] sing-box


# ========== landscape ==========
