# ============================================================
# Alpine Linux 包列表
#
# 语法：
#   [pm] <package>                —— 包管理器安装（apk add）
#   [dl@<url>] <binary_name>      —— 下载 URL 到 /usr/local/bin/<binary_name>
#
# 四段式：base / base-net / sing-box / landscape
# ============================================================

# ========== base ==========
[pm] openssh
[pm] chrony
[pm] ca-certificates-bundle
[pm] curl
[pm] bash
[pm] nano
[pm] kmod
[pm] iproute2
[pm] rsync
[pm] util-linux
[pm] e2fsprogs-extra
[pm] cloud-utils-growpart
[pm] tzdata
[pm] busybox-openrc
[pm] fastfetch
[pm] podman
[pm] podman-compose

# ========== base-net ==========
# 基础网络栈。landscape 自带 DNS/DHCP（不占 53）、eBPF 防火墙、虚拟组网与隧道，
# 整段跳过，否则 dnsmasq 会占住 53 端口导致 landscape 起不来
[pm] dnsmasq
[pm] nftables
[pm] tailscale
[dl@https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64] cloudflared

# ========== sing-box ==========
[pm] sing-box

# ========== landscape ==========
# 二进制与前端资源不走包管理器（要解 static.zip、并用同版本二进制生成
# landscape_init.toml），见 landscape/install.sh。这里只放它依赖的工具
[pm] unzip
