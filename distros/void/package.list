# ============================================================
# Void Linux 包列表
#
# 语法：
#   [pm] <package>                —— 包管理器安装（xbps-install）
#   [dl@<url>] <binary_name>      —— 下载 URL 到 /usr/local/bin/<binary_name>
#                                   自动解压 .tar.gz，查找二进制文件
#
# 三段式：base / sing-box / landscape
# ============================================================

# ========== base ==========
[pm] bash
[pm] openssh
[pm] chrony
[pm] curl
[pm] nano
[pm] ncurses
[pm] ncurses-base
[pm] dnsmasq
[pm] nftables
[pm] runit-nftables
[pm] tailscale
[pm] iproute2
[pm] cloudflared
[pm] fastfetch
[pm] podman
[pm] podman-compose

# ========== sing-box ==========
# 1.14+ 才支持 bridge outbound；Void 仓库版本不保证，直接下载上游二进制
[dl@https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-linux-arm64.tar.gz] sing-box

# ========== landscape ==========
