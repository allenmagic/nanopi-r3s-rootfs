table inet nat {
    # ==============================================================================
    # 集合定义
    # ==============================================================================
    set lan_interfaces {
        type ifname;
        elements = $LAN_IFS_LIST;
    }

    set wan_interfaces {
        type ifname;
        elements = $WAN_IFS_LIST;
    }

    set vpn_interfaces {
        type ifname;
        elements = $VPN_IFS_LIST;
    }

    set tun_interfaces {
        type ifname;
        elements = $SB_TUN_IFS_LIST;
    }

    set yunshu_interfaces {
        type ifname;
        elements = $YUNSHU_IFS_LIST;
    }

    # ============================================================
    # PREROUTING 链 (DNAT - 端口转发)
    # ============================================================
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        # LAN 内自行配置的 DNS 也强制归口到 sing-box 的 dns-in
        # （sing-box 监听 ROUTER_LAN_IP:53；redirect 使用入接口主地址）
        iifname @lan_interfaces udp dport $DNS_PORT redirect to :$DNS_PORT;
        iifname @lan_interfaces tcp dport $DNS_PORT redirect to :$DNS_PORT;
    }

    # ============================================================
    # POSTROUTING 链 (SNAT - 共享上网)
    # ============================================================
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        #---------------------- WAN 口上网 NAT (仅限 IPv4) -------------------------
        meta nfproto ipv4 oifname @wan_interfaces masquerade;

        #---------------------- VPN 访问内网 NAT (仅限 IPv4) -----------------------
        meta nfproto ipv4 iifname @vpn_interfaces oifname @lan_interfaces masquerade;
    }
}
