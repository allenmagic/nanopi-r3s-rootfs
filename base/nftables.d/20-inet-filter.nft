table inet filter {
    # ===============================================================================================
    # 定义集合变量：LAN_IFS_LIST/WAN_IFS_LIST/VPN_IFS_LIST/SB_TUN_IFS_LIST/YUNSHU_IFS_LIST
    # 在 00-inet-vars.nft 中定义
    # ===============================================================================================
    set lan_interfaces {
        type ifname;
        elements = $LAN_IFS_LIST;
    }

    set wan_interfaces {
        type ifname;
        elements = $WAN_IFS_LIST;
    }

    set vpn_interfaces {
         type ifname;
         elements = $VPN_IFS_LIST;
    }

    # sing-box 的 TUN（singtun0）
    set tun_interfaces {
        type ifname;
        elements = $SB_TUN_IFS_LIST;
    }

    # yunshu 的 TUN（tun0）
    set yunshu_interfaces {
        type ifname;
        elements = $YUNSHU_IFS_LIST;
    }

    # WAN 侧管理放行网段（运行时由 wan-mgmt 服务填入 WAN 口直连网段）
    set wan_mgmt_nets {
        type ipv4_addr;
        flags interval;
    }

    # ========= 动态黑名单 (分离 IPv4/IPv6) =========
    set flood_blacklist_v4 {
        type ipv4_addr;
        flags dynamic, timeout;
        timeout 1h;
    }

    set flood_blacklist_v6 {
        type ipv6_addr;
        flags dynamic, timeout;
        timeout 1h;
    }

    flowtable f {
        hook ingress priority 0;
        devices = { $WAN, $LAN };
    }

    # ============================================================
    # INPUT链 (控制面板), 主要处理入站路由器的连接请求
    # ============================================================
    chain input {
        type filter hook input priority filter; policy drop;

        # ------------------ 允许回环 ----------------------
        iif lo accept;

        # --------------- 允许已建立的连接 -------------------
        ct state established,related accept;

        # ------------------ 丢弃无效连接 --------------------
        ct state invalid drop;

        # --------------- 丢弃动态黑名单的连接 -----------------
        iifname @wan_interfaces ip saddr @flood_blacklist_v4 drop;
        iifname @wan_interfaces ip6 saddr @flood_blacklist_v6 drop;

        # --------------- WAN 请求连接 ------------------------
        # 允许 WireGuard/Tailscale 的 UDP 握手包建立隧道
        iifname @wan_interfaces udp dport $WG_PORT accept;
        iifname @wan_interfaces udp dport $TS_PORT accept;

        # 超限流量：记录日志并加入黑名单后丢弃
        iifname @wan_interfaces ct state new tcp flags syn \
            tcp dport != { $WG_PORT, $TS_PORT } \
            limit rate over 100/second burst 200 packets \
            log prefix "WAN_SYN_FLOOD_v4: " \
            add @flood_blacklist_v4 { ip saddr } \
            drop;

        iifname @wan_interfaces ct state new tcp flags syn \
            limit rate over 100/second burst 200 packets \
            log prefix "WAN_SYN_FLOOD_v6: " \
            add @flood_blacklist_v6 { ip6 saddr } \
            drop;

        # ========= ICMP 控制面板 (IPv4 / IPv6) =========
        # --------------- IPv4 ICMP  -----------------------
        # 分别为每个 ICMP 类型添加限速
        iifname @wan_interfaces icmp type { 
            echo-request, 
            destination-unreachable, 
            time-exceeded, 
            parameter-problem 
        } limit rate 5/second burst 10 packets accept;

        # ---------------- Tailscale ICMP -----------------------
        ip saddr $TS_NET icmp type { 
            echo-request, 
            destination-unreachable, 
            time-exceeded, 
            parameter-problem 
        } limit rate 5/second burst 10 packets accept;

        # ---------------- IPv6 ICMP -----------------------
        # 分别为每个 ICMP 类型添加限速
        iifname @wan_interfaces icmpv6 type { 
            echo-request, 
            destination-unreachable, 
            time-exceeded, 
            parameter-problem 
        } limit rate 5/second burst 10 packets accept;

        # ---------------- IPv6 邻居发现  ---------------------
        iifname @wan_interfaces meta l4proto ipv6-icmp icmpv6 type {
            nd-router-solicit,
            nd-router-advert,
            nd-neighbor-solicit,
            nd-neighbor-advert
        } accept;

        # ---------------- SSH 管理 ( LAN / VPN / TUN / Tailscale / WAN 同网段 ) --------------
        iifname @lan_interfaces tcp dport $SSH_PORT ct state new limit rate 30/minute burst 20 packets accept;
        iifname @tun_interfaces tcp dport $SSH_PORT ct state new limit rate 30/minute burst 20 packets accept;
        iifname @vpn_interfaces tcp dport $SSH_PORT ct state new limit rate 60/minute burst 30 packets accept;
        iifname @wan_interfaces ip saddr @wan_mgmt_nets tcp dport $SSH_PORT ct state new limit rate 30/minute burst 20 packets accept;

        # ----------------  DHCP  -----------------------------
        iifname @lan_interfaces udp dport { 67, 68 } accept;

        # -------------------  DNS  ---------------------------
        iifname @lan_interfaces udp dport $DNS_PORT accept;
        iifname @tun_interfaces udp dport $DNS_PORT accept;
        iifname @lan_interfaces tcp dport $DNS_PORT accept;
        iifname @tun_interfaces tcp dport $DNS_PORT accept;

        # yunshu 隧道 DNS 回包（sing-box -> 10.251.1.1 的查询）
        iifname @yunshu_interfaces ip saddr $YUNSHU_DNS udp sport $DNS_PORT accept;
        iifname @yunshu_interfaces ip saddr $YUNSHU_DNS tcp sport $DNS_PORT accept;

        # ------------------  ICMP (LAN)  ---------------------
        iifname @lan_interfaces icmp type {
            echo-request,
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept;

        # ------------------  ICMP (LAN)  ---------------------
        iifname @tun_interfaces icmp type {
            echo-request,
            destination-unreachable,
            time-exceeded,
            parameter-problem
        } accept;

        # ------------------ 流量放行上网 ------------------------
        iifname @vpn_interfaces accept;
        iifname @tun_interfaces accept;
        iifname @lan_interfaces accept;

        # limit 必须在 log 之前：反序（log 在前）会让每个丢包都先记一条日志，
        # 限速只作用于其后的 drop，等于没有限速 → 日志洪泛。
        limit rate 10/minute log prefix "INPUT_DROP: " drop;
    }

    # ============================================================
    # FORWARD 链 (数据面板)， 主要处理路由转发的数据包
    # ============================================================
    chain forward {
        type filter hook forward priority filter; policy drop;

        # ------------------- 流量卸载加速 -----------------------
        ip protocol { tcp, udp } flow offload @f;

        # ------------------- Baseline -------------------------
        ct state established,related accept;
        ct state invalid drop;

        # -------------------- MSS Clamping ---------------------
        tcp flags syn tcp option maxseg size set rt mtu;

        # 注意：这里有意不放行 LAN -> WAN。
        # sing-box 全量接管 LAN（auto_redirect -> singtun0），普通流量由
        # sing-box 的 final 出口 direct-out 发出，不经过内核 LAN->WAN 直通。

        # --------------------- LAN -> sing-box TUN --------------
        iifname @lan_interfaces oifname @tun_interfaces accept;

        # --------------------- sing-box TUN -> WAN/LAN ----------
        iifname @tun_interfaces oifname @wan_interfaces accept;
        iifname @tun_interfaces oifname @lan_interfaces accept;

        # --------------------- bridge 内部 TUN <-> yunshu -------
        # sing-box bridge 出站创建 sbbr*，把 fake-IP 的 L3 包转给 tun0
        iifname "sbbr*" oifname @yunshu_interfaces accept;
        iifname @yunshu_interfaces oifname "sbbr*" accept;

        # --------------------- fake-IP 直通兜底 -----------------
        # sing-box 未运行时，198.18/15 的 main 路由会把包直接送进 tun0
        iifname @lan_interfaces oifname @yunshu_interfaces accept;
        iifname @yunshu_interfaces oifname @lan_interfaces accept;

        # --------------------- Tailscale -> TUN 转发 ------------
        ip saddr $TS_NET oifname @tun_interfaces accept;

        # --------------------- LAN -> LAN 转发 -----------------
        iifname @lan_interfaces oifname @lan_interfaces accept;

        # ---------------------- VPN Routing --------------------
        iifname @vpn_interfaces oifname @lan_interfaces accept;
        iifname @lan_interfaces oifname @vpn_interfaces accept;
        iifname @vpn_interfaces oifname @tun_interfaces accept;
        iifname @tun_interfaces oifname @vpn_interfaces accept;
        iifname @vpn_interfaces oifname @yunshu_interfaces accept;
        iifname @yunshu_interfaces oifname @vpn_interfaces accept;
        # VPN 客户端的普通上网不做 auto_redirect，直接走 WAN
        iifname @vpn_interfaces oifname @wan_interfaces accept;

        limit rate 10/minute log prefix "FORWARD_DROP: " drop;
    }

    # ============================================================
    # OUTPUT 链， 主要处理出站连接请求
    # ============================================================
    chain output {
        type filter hook output priority filter; policy accept;
        # 同上：限速在前、日志在后
        ct state new limit rate 5/minute log prefix "OUTPUT_NEW: " accept;
    }
}
