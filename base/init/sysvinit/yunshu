#!/bin/sh
### BEGIN INIT INFO
# Provides:          yunshu
# Required-Start:    $network $local_fs nftables
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: YunShu container + tun0 routes
### END INIT INFO

ENVFILE=/etc/yunshu/yunshu.env
COMPOSE=/etc/yunshu/compose.yaml
COMPOSE_CMD="/usr/bin/podman-compose --in-pod=false --env-file ${ENVFILE} -f ${COMPOSE}"
ROUTES_BIN=/usr/local/bin/vpn-routes
ROUTES_PID=/run/yunshu-routes.pid

[ -f "$ENVFILE" ] && . "$ENVFILE"
VPN_IFACE="${VPN_IFACE:-tun0}"

case "$1" in
    start)
        echo "Starting yunshu..."
        $COMPOSE_CMD up -d || exit 1
        i=0
        while [ "$i" -lt 60 ]; do
            ip link show "$VPN_IFACE" >/dev/null 2>&1 && break
            sleep 1
            i=$((i + 1))
        done
        start-stop-daemon --start --quiet --background --make-pidfile \
            --pidfile "$ROUTES_PID" --exec "$ROUTES_BIN" -- daemon
        ;;
    stop)
        echo "Stopping yunshu..."
        start-stop-daemon --stop --quiet --pidfile "$ROUTES_PID" || true
        "$ROUTES_BIN" del 2>/dev/null || true
        rm -f "$ROUTES_PID"
        $COMPOSE_CMD down || true
        ;;
    restart) "$0" stop; "$0" start ;;
    status)
        if [ -f "$ROUTES_PID" ] && kill -0 "$(cat "$ROUTES_PID")" 2>/dev/null; then
            echo "yunshu routes is running"
        else
            echo "yunshu routes is not running"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
