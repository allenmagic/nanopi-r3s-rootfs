#!/bin/sh

command -v ethtool >/dev/null 2>&1 && {
    ethtool -K eth0 rx-udp-gro-forwarding on 2>/dev/null
    ethtool -K eth1 rx-udp-gro-forwarding on 2>/dev/null
}

# RPS 需内核 CONFIG_RPS；当前未启用，路径不存在时跳过
if [ -d /sys/class/net/eth0/queues ]; then
    for x in /sys/class/net/eth*/queues/rx-*/rps_cpus; do
        [ -w "$x" ] && echo "f" > "$x" 2>/dev/null
    done
fi

for i in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
    [ -w "$i" ] && echo "schedutil" > "$i" 2>/dev/null
done

exit 0
