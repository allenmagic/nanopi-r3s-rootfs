# .env.example —— 本地构建环境变量模板
#
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填写实际的密钥和配置
#   3. 构建时会自动加载 .env 中的变量
#
# 注意：.env 文件已被 .gitignore 忽略，不会提交到 Git

# ==========================================
# 构建配置
# ==========================================
# INFRA=base                    # 路由组件：base / sing-box
# REPO=tuna                     # 镜像源：default / tuna / tsinghua / aliyun
# ROOT_PASSWORD=your_password   # root 用户密码
# HOSTNAME_VAL=my-router        # 主机名

# ==========================================
# 密钥注入（可选，未设则跳过）
# ==========================================
# SSH 密钥（注入到 /root/.ssh/）
# SSH_PRIVATE_KEY="$(cat ~/.ssh/id_ed25519)"
# SSH_PUBLIC_KEY="$(cat ~/.ssh/id_ed25519.pub)"

# Tailscale 认证密钥（注入到 /etc/tailscale/authkey）
# TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxxx

# Headscale 认证密钥（注入到 sing-box config.json）
# HEADSCALE_AUTH_KEY=xxxxxxxxxxxxx

# Cloudflared Tunnel Token（注入到 /etc/cloudflared/config.yml）
# CLOUDFLARED_TOKEN=xxxxxxxxxxxxx
